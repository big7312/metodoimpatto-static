---
import "../styles/global.css";
import { SITE, navItems } from "../consts";
import regularFont from "../assets/fonts/FiraSans-Regular.woff2?url";
import boldFont from "../assets/fonts/FiraSans-SemiBold.woff2?url";
import headingFont from "../assets/fonts/Literata72pt-SemiBold.woff2?url";

type Props = {
  title?: string;
  description?: string;
};

const { title = SITE.title, description = SITE.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <link rel="preload" href={regularFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={boldFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip-link" href="#content">Salta al contenuto</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Metodo IMPATTO home">
        <span class="brand-mark">MI</span>
        <span>Metodo IMPATTO</span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">
        <svg class="nav-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path class="nav-icon-open" d="M4 6h16M4 12h16M4 18h16" />
          <path class="nav-icon-close" d="m6 6 12 12M18 6 6 18" />
        </svg>
        <span class="nav-toggle-label">Apri menu</span>
      </button>
      <nav id="site-navigation" class="site-nav" aria-label="Navigazione principale">
        {navItems.map((item) => (
          <a href={item.href} aria-current={Astro.url.pathname === item.href || (item.href !== "/" && Astro.url.pathname.startsWith(item.href)) ? "page" : undefined}>{item.label}</a>
        ))}
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <p class="eyebrow">Metodo IMPATTO</p>
        <p>AI utile, prima degli strumenti. Una base editoriale per scegliere meglio dove usare l'intelligenza artificiale.</p>
      </div>
      <div class="footer-links">
        <a href="/newsletter/">Il Prompt della Settimana</a>
        <a href="/privacy/">Privacy</a>
        <a href="/contatti/">Contatti</a>
      </div>
    </footer>
    <script>
      const header = document.querySelector<HTMLElement>(".site-header");
      const toggle = header?.querySelector<HTMLButtonElement>(".nav-toggle");
      const navigation = header?.querySelector<HTMLElement>(".site-nav");
      const label = toggle?.querySelector<HTMLElement>(".nav-toggle-label");

      if (header && toggle && navigation && label) {
        const mobile = window.matchMedia("(max-width: 980px)");
        const setOpen = (open: boolean) => {
          toggle.setAttribute("aria-expanded", String(open));
          label.textContent = open ? "Chiudi menu" : "Apri menu";
        };

        toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
        header.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
            setOpen(false);
            toggle.focus();
          }
        });
        document.addEventListener("click", (event) => {
          if (event.target instanceof Node && !header.contains(event.target)) {
            if (mobile.matches && navigation.contains(document.activeElement)) toggle.focus();
            setOpen(false);
          }
        });
        navigation.addEventListener("click", (event) => {
          if (event.target instanceof Element && event.target.closest("a")) setOpen(false);
        });
        mobile.addEventListener("change", () => {
          if (mobile.matches && navigation.contains(document.activeElement)) toggle.focus();
          setOpen(false);
        });
      }
    </script>
  </body>
</html>
