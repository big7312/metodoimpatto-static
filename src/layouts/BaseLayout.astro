---
import "../styles/global.css";
import { SITE, navItems } from "../consts";

type Props = {
  title?: string;
  description?: string;
};

const { title = SITE.title, description = SITE.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip-link" href="#content">Salta al contenuto</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Metodo IMPATTO home">
        <span class="brand-mark">MI</span>
        <span>Metodo IMPATTO</span>
      </a>
      <nav class="site-nav" aria-label="Navigazione principale">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <p class="eyebrow">Metodo IMPATTO</p>
        <p>AI utile, prima degli strumenti. Una base editoriale per scegliere meglio dove usare l'intelligenza artificiale.</p>
      </div>
      <div class="footer-links">
        <a href="/newsletter/">Il Prompt della Settimana</a>
        <a href="/privacy/">Privacy</a>
        <a href="/contatti/">Contatti</a>
      </div>
    </footer>
  </body>
</html>
