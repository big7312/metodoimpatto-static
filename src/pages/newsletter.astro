---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsletterBox from "../components/NewsletterBox.astro";
---

<BaseLayout title="Il Prompt della Settimana | Metodo IMPATTO">
  <section class="prose">
    <p class="eyebrow">Newsletter</p>
    <h1>Una mail breve da tenere aperta mentre lavori.</h1>
    <p class="lead">
      Ogni venerdi ricevi un esempio pratico per usare l'AI in modo piu lucido: cosa chiedere, cosa evitare, come valutare il risultato.
    </p>
  </section>
  <NewsletterBox />
</BaseLayout>
