---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsletterBox from "../../components/NewsletterBox.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const articles = (await getCollection("articles")).filter((article) => !article.data.draft);
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---

<BaseLayout title={`${article.data.title} | Metodo IMPATTO`} description={article.data.description}>
  <article class="prose">
    <p class="eyebrow">{article.data.category}</p>
    <h1>{article.data.title}</h1>
    <p class="lead">{article.data.description}</p>
    <time datetime={article.data.pubDate.toISOString()}>
      {article.data.pubDate.toLocaleDateString("it-IT", { day: "2-digit", month: "long", year: "numeric" })}
    </time>
    <Content />
  </article>
  <NewsletterBox compact />
</BaseLayout>
